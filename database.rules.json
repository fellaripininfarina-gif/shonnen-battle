{
  "rules": {
    ".read": false,
    ".write": false,

    "queue": {
      "$mode": {
        ".read": "auth != null",
        ".validate": "$mode === '1v1' || $mode === '2v2'",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('queue').child($mode).child(auth.uid).exists() && newData.parent().parent().parent().child('rooms').child(newData.parent().parent().parent().child('matches').child($uid).val()).child('host').val() === auth.uid))",
          ".validate": "newData.hasChildren(['name', 'char', 't'])",
          "name": { ".validate": "newData.isString() && auth.token.email === newData.val() + '@shonnenbattle.game'" },
          "char": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 63" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "matches": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (newData.isString() && newData.parent().parent().child('rooms').child(newData.val()).child('host').val() === auth.uid))",
        ".validate": "newData.isString() && newData.val().length <= 40"
      }
    },

    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['mode', 'host', 'players'])",
        "mode": { ".validate": "newData.val() === '1v1' || newData.val() === '2v2'" },
        "inputs": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "mx": { ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2" },
            "my": { ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2" },
            "ax": { ".validate": "newData.isNumber()" },
            "ay": { ".validate": "newData.isNumber()" },
            "fire": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "dash": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "special": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "q": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "ult": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "fc": { ".validate": "newData.isNumber()" },
            "seq": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && auth.token.email === newData.val() + '@shonnenbattle.game'" },
        "$other": { ".validate": false }
      }
    },
    "usernames": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === $name + '@shonnenbattle.game' && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.val() === auth.uid"
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === 1"
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friend": {
          ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || root.child('requests').child($uid).child($friend).exists())) || (auth.uid === $friend && (!newData.exists() || root.child('requests').child($friend).child($uid).exists())))",
          ".validate": "newData.hasChildren(['name', 't'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $from || auth.uid === $to)",
          ".validate": "newData.hasChildren(['name', 't'])",
          "name": { ".validate": "newData.isString() && auth.token.email === newData.val() + '@shonnenbattle.game'" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && ((auth.uid === $from && root.child('friends').child($from).child($to).exists()) || auth.uid === $to)",
          ".validate": "newData.hasChildren(['name', 'party', 't'])",
          "name": { ".validate": "newData.isString() && auth.token.email === newData.val() + '@shonnenbattle.game'" },
          "party": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "t": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "parties": {
      "$party": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() ? newData.child('host').val() === auth.uid : data.child('host').val() === auth.uid)",
        "mode": { ".validate": "newData.val() === '1v1' || newData.val() === '2v2'" },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "char": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 63" },
            "team": { ".validate": "newData.val() === 0 || newData.val() === 1" }
          }
        }
      }
    }
  }
}
